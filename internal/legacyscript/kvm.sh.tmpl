#!/bin/sh
# Adds this GL KVM to the self-hosted GLKVM Cloud at {{.Server}}.
# For firmware below V1.11.0: newer firmware joins with an access code.
# Generated by GLKVM Cloud {{.Version}}. It holds the platform's device token:
# keep it private.

if [ ! -r /proc/gl-hw-info/device_ddns ]; then
	echo "This script is for GL KVM devices only." >&2
	exit 1
fi
if pidof rtty-go >/dev/null 2>&1; then
	echo "rtty-go is running: this KVM joins platforms with an access code." >&2
	echo "Add it with an access code, or leave its current platform on the KVM first." >&2
	exit 1
fi

DIR=/etc/kvmd/user
SCRIPTS=$DIR/scripts
CA_FILE=$DIR/selfhost-ca.crt
S01=$SCRIPTS/S01selfCloud
LOOP=$SCRIPTS/rtty-loop.sh

mkdir -p "$SCRIPTS" || exit 1

# The platform's CA, which the connection is checked against.
cat > "$CA_FILE.new" <<'GLKVM_CA'
{{.CA}}GLKVM_CA

printf '{\n    "webui_url": %s,\n    "updated_at": "%s"\n}\n' {{sh .WebUIJSON}} \
	"$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$DIR/selfhost-cloud.json.new"

cat > "$S01.new" <<'GLKVM_S01'
#!/bin/sh
# Self-hosted GLKVM Cloud, written by the platform's add device script.
LOOP=/etc/kvmd/user/scripts/rtty-loop.sh

start() {
	if pgrep -f "$LOOP" >/dev/null; then
		echo "self-hosted cloud is already started"
		return 0
	fi
	echo "starting self-hosted cloud"
{{- if .TURN}}
	cat > /tmp/turnserver.json <<'GLKVM_TURN'
{{.TURN}}
GLKVM_TURN
{{- end}}
	nohup "$LOOP" >/dev/null 2>&1 &
	echo "started self-hosted cloud"
}

stop() {
	echo "stopping self-hosted cloud"
	device_mac=$(cat /proc/gl-hw-info/device_mac)
	pkill -f "$LOOP"
	pkill -f "rtty.*-d $device_mac"
	echo "stopped self-hosted cloud"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
GLKVM_S01

cat > "$LOOP.new" <<'GLKVM_LOOP'
#!/bin/sh
# Keeps this KVM connected to the self-hosted GLKVM Cloud.
SERVER={{sh .Server}}
TOKEN={{sh .Token}}
CA_FILE=/etc/kvmd/user/selfhost-ca.crt
# Firmware whose rtty has no -s/-x/-C always uses TLS and checks the server
# against this file. GL.iNet Cloud writes it too, which is why the two clouds
# cannot be used together on such firmware.
FW_CA=/var/run/gl-rtty/ca.crt

device_id=$(cat /proc/gl-hw-info/device_ddns)
device_mac=$(cat /proc/gl-hw-info/device_mac)

fixed_ca=
if rtty -C 2>&1 | grep -q "invalid option"; then
	fixed_ca=1
fi

# Without -a rtty exits when the link drops, so every connection starts here
# and, on such firmware, with the platform's CA in place.
while true; do
	if ! pgrep -f "rtty.*-d $device_mac" >/dev/null; then
		if [ -n "$fixed_ca" ]; then
			mkdir -p "${FW_CA%/*}" && cp "$CA_FILE" "$FW_CA.new" && mv -f "$FW_CA.new" "$FW_CA"
			rtty -T 2 -I "$device_id" -h "$SERVER" -t "$TOKEN" -d "$device_mac" &
		else
			rtty -s -C "$CA_FILE" -T 2 -I "$device_id" -h "$SERVER" -t "$TOKEN" -d "$device_mac" &
		fi
	fi
	sleep 5
done
GLKVM_LOOP

# Replace the files whole: a running watchdog keeps reading its old copy.
chmod 755 "$S01.new" "$LOOP.new" || exit 1
mv -f "$CA_FILE.new" "$CA_FILE"
mv -f "$DIR/selfhost-cloud.json.new" "$DIR/selfhost-cloud.json"
mv -f "$LOOP.new" "$LOOP"
mv -f "$S01.new" "$S01"

"$S01" restart

echo
echo "This KVM now connects to {{.Server}} in the background."
echo "GL.iNet Cloud and the self-hosted platform cannot be used together:"
echo "keep GL.iNet Cloud turned off on this KVM."
if command -v openssl >/dev/null 2>&1; then
	echo "Platform CA, to compare with the add device dialog or the server log:"
	openssl x509 -noout -fingerprint -sha256 -in "$CA_FILE"
fi
sleep 6
echo "Latest rtty log lines (logread | grep rtty shows them all):"
logread 2>/dev/null | grep rtty | tail -n 3
